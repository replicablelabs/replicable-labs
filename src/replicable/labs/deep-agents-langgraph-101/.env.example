MODEL_PROVIDER=openai
MODEL_NAME=gpt-4.1-mini
OPENAI_API_KEY=
OPENAI_AUTH_MODE=
ANTHROPIC_API_KEY=
LANGSMITH_TRACING=true
# Prefer `langsmith auth login`; an API key is an alternative.
LANGSMITH_API_KEY=
LANGSMITH_PROFILE=
# Agent-based workspace: create an agent in LangSmith and set its ID.
LANGSMITH_AGENT_ID=
LANGSMITH_AGENT_ENVIRONMENT=local
# Project-based workspace: leave AGENT_ID empty and use this project.
LANGSMITH_PROJECT=replicable-deep-agents-langgraph-101
# Change the endpoint for an EU or other non-default LangSmith deployment.
# Leave blank to use the endpoint saved by browser login.
LANGSMITH_ENDPOINT=
LANGSMITH_WORKSPACE_ID=

