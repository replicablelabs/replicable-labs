# Copy to .env (gitignored) and fill in. Exported shell variables take precedence over .env.
# Katas 1-4 and `pytest` need NO key. Only the live katas (5 and 6) call the API.

ANTHROPIC_API_KEY=

# Optional: model used by the live katas and the starter/solution code (default: claude-sonnet-5-5)
# KATA_MODEL=claude-sonnet-5-5

# Optional: which implementation the tests / live runner load: starter (default) | solution
# KATA_IMPL=starter
