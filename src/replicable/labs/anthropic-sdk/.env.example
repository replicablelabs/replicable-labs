# Copy to .env (gitignored) and fill in. Exported shell variables take precedence over .env.
# The tests need NO key. Only `kata run` calls the API.

ANTHROPIC_API_KEY=

# LangSmith tracing (optional). Set LANGSMITH_TRACING=true to send traces.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
# The LangSmith project this lab's traces go to.
LANGSMITH_PROJECT=