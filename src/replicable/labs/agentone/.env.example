# Copy to .env (gitignored) and fill in. Exported shell variables take precedence over .env.

# ---- API keys (only for the providers you select below) ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
VOYAGE_API_KEY=            # only if EMBEDDING_PROVIDER=voyage
LANGSMITH_API_KEY=         # optional: tracing / LangSmith evals
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=agentone

# ---- Which model does which job ----
# INFERENCE: tutor replies, intent router, card drafting, answer judge
INFERENCE_PROVIDER=openai          # anthropic | openai
INFERENCE_MODEL=gpt-4.1            # e.g. claude-sonnet-5-5
# EXTRACTION: card -> knowledge-graph nodes and edges (a cheaper model is fine)
EXTRACTION_PROVIDER=openai         # anthropic | openai
EXTRACTION_MODEL=gpt-4.1-mini      # e.g. claude-haiku-5-5
# EMBEDDING: card text -> vector. Anthropic has NO embeddings API: use openai, or voyage (Anthropic's recommended provider)
EMBEDDING_PROVIDER=openai          # openai | voyage | hash (hash = offline/tests only)
EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIM=                   # only for models not in the built-in table

# ---- Storage (scripts/services.sh start brings these up locally, no Docker) ----
DATABASE_URL=postgresql://localhost:5433/agentone   # relational: cards, attempts  (5433: 5432 is often taken by an ssh tunnel)
QDRANT_URL=http://localhost:6333                    # vectors + semantic search over card content
NEO4J_URI=bolt://localhost:7687                     # knowledge graph of card content
NEO4J_USER=neo4j
NEO4J_PASSWORD=agentone-local
