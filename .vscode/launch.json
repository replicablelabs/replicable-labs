// Run and Debug (Cmd+Shift+D). Assumes VS Code is opened at the repo root; if you open the lab folder,
// replace ${workspaceFolder}/src/replicable/labs/agent-katas with ${workspaceFolder}.
{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/src/replicable/labs/agent-katas/.venv/bin/python",
      "cwd": "${workspaceFolder}/src/replicable/labs/agent-katas",
      "console": "integratedTerminal",
      "justMyCode": true,
      "name": "k00 run (real model)",
      "module": "katas",
      "args": ["run", "k00", "Create a card about the capital of France, then schedule it for 2026-12-01 at 9am."]
    },
    {
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/src/replicable/labs/agent-katas/.venv/bin/python",
      "cwd": "${workspaceFolder}/src/replicable/labs/agent-katas",
      "console": "integratedTerminal",
      "justMyCode": true,
      "name": "k00 tests",
      "module": "pytest",
      "args": ["tests/test_k00.py", "-vv", "-s", "--no-header", "-p", "no:cacheprovider"]
    }
  ]
}
